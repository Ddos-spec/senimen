---
import BaseLayout from '../layouts/BaseLayout.astro';
import { driveArchive } from '../data/media';
import { brand } from '../data/brand';

const hash = (value: string) => {
  let out = 2166136261;
  for (let i = 0; i < value.length; i += 1) {
    out ^= value.charCodeAt(i);
    out = Math.imul(out, 16777619);
  }
  return out >>> 0;
};

const scatterByGroup = <T extends { id: string; group: string }>(items: T[]) => {
  const buckets = new Map<string, T[]>();
  items.forEach((item) => {
    const bucket = buckets.get(item.group) ?? [];
    bucket.push(item);
    buckets.set(item.group, bucket);
  });
  buckets.forEach((bucket) => bucket.sort((a, b) => hash(a.id) - hash(b.id)));

  const result: T[] = [];
  const recent: string[] = [];
  while (result.length < items.length) {
    const available = [...buckets.entries()].filter(([, bucket]) => bucket.length > 0);
    available.sort(([groupA, bucketA], [groupB, bucketB]) => {
      const penaltyA = recent.includes(groupA) ? 10000 : 0;
      const penaltyB = recent.includes(groupB) ? 10000 : 0;
      const sizeBias = (bucketB.length - bucketA.length) * 25;
      const jitterA = hash(`${groupA}:${result.length}`) % 997;
      const jitterB = hash(`${groupB}:${result.length}`) % 997;
      return penaltyA - penaltyB + sizeBias + jitterA - jitterB;
    });

    const [group, bucket] = available[0];
    const item = bucket.shift();
    if (!item) break;
    result.push(item);
    recent.push(group);
    if (recent.length > 3) recent.shift();
  }
  return result;
};

const archiveItems = scatterByGroup([...driveArchive]);
const total = archiveItems.length;
const imageCount = archiveItems.filter((item) => item.kind === 'image').length;
const motionCount = archiveItems.filter((item) => item.kind === 'video').length;
const audioCount = archiveItems.filter((item) => item.kind === 'audio').length;

const gridThumb = (id: string) => `https://drive.google.com/thumbnail?id=${id}&sz=w420`;
const fullImage = (id: string) => `https://drive.google.com/thumbnail?id=${id}&sz=w1800`;
const directMedia = (id: string) => `https://drive.google.com/uc?export=download&id=${id}`;
const transparentPixel = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==';

const thumbFor = (item: (typeof archiveItems)[number]) => item.kind === 'audio' ? brand.logoSmall : gridThumb(item.id);
const fallbackFor = (item: (typeof archiveItems)[number]) => {
  if (item.kind === 'audio') return brand.logoSmall;
  if (item.kind === 'video') {
    const group = item.group.toUpperCase();
    if (group.includes('WAWANCARA') || group.includes('INTERVIEW') || group.includes('FILM')) return brand.tanyaTanya;
    return brand.balikLayar;
  }
  return brand.logoSmall;
};
---
<BaseLayout title="Arsip — SENIMEN" description="Foto, video, dan rekaman dari kegiatan serta karya yang terkumpul di SENIMEN." image={brand.og}>
  <main class="page archive-page">
    <section class="route-hero archive-drive-hero">
      <div>
        <span class="page-kicker">ARSIP / SENIMEN</span>
        <h1 class="page-title">ARSIP.</h1>
      </div>
      <div class="route-count">{total} BERKAS / {imageCount} FOTO / {motionCount} VIDEO / {audioCount} AUDIO</div>
    </section>

    <section class="archive-masonry archive-drive-masonry" aria-label="Arsip media SENIMEN">
      {archiveItems.map((item, index) => {
        const thumb = thumbFor(item);
        const fallback = fallbackFor(item);
        const eager = index < 6;
        const shape = hash(item.id) % 5;
        return (
          <article class={`archive-pin archive-pin--${item.kind} archive-pin--shape-${shape}`}>
            <button
              type="button"
              class="archive-pin-media archive-pin-trigger"
              aria-label={`Buka ${item.group} — ${item.title}`}
              data-index={index}
              data-kind={item.kind}
              data-title={item.title}
              data-group={item.group}
              data-mime={item.mimeType}
              data-image={item.kind === 'image' ? fullImage(item.id) : ''}
              data-media={item.kind !== 'image' ? directMedia(item.id) : ''}
              data-poster={thumb}
            >
              <img
                class="archive-pin-thumb"
                src={eager ? thumb : transparentPixel}
                data-src={eager ? undefined : thumb}
                data-fallback={fallback}
                alt={`${item.group} — ${item.title}`}
                loading={eager ? 'eager' : 'lazy'}
                fetchpriority={index < 2 ? 'high' : 'low'}
                decoding="async"
              />
              {item.kind !== 'image' && (
                <span class="archive-kind-badge" aria-hidden="true">
                  <b>{item.kind === 'video' ? '▶' : '♪'}</b>
                  <span>{item.kind === 'video' ? 'PLAY' : 'DENGAR'}</span>
                </span>
              )}
            </button>
            <div class="archive-pin-meta">
              <span>{item.group}</span>
              <span>{item.kind.toUpperCase()} / {String(index + 1).padStart(2, '0')}</span>
            </div>
          </article>
        );
      })}
    </section>
  </main>

  <dialog class="archive-viewer" id="archive-viewer" aria-label="Viewer arsip SENIMEN">
    <button class="archive-viewer-close" type="button" aria-label="Tutup viewer">TUTUP ×</button>
    <button class="archive-viewer-nav archive-viewer-prev" type="button" aria-label="Media sebelumnya">←</button>
    <button class="archive-viewer-nav archive-viewer-next" type="button" aria-label="Media berikutnya">→</button>
    <div class="archive-viewer-shell">
      <div class="archive-viewer-media" id="archive-viewer-media"></div>
      <div class="archive-viewer-meta">
        <span id="archive-viewer-group"></span>
        <strong id="archive-viewer-title"></strong>
        <small id="archive-viewer-count"></small>
      </div>
    </div>
  </dialog>

  <script is:inline>
    (() => {
      const dialog = document.getElementById('archive-viewer');
      const media = document.getElementById('archive-viewer-media');
      const title = document.getElementById('archive-viewer-title');
      const group = document.getElementById('archive-viewer-group');
      const count = document.getElementById('archive-viewer-count');
      const close = dialog?.querySelector('.archive-viewer-close');
      const prev = dialog?.querySelector('.archive-viewer-prev');
      const next = dialog?.querySelector('.archive-viewer-next');
      const triggers = Array.from(document.querySelectorAll('.archive-pin-trigger'));
      const deferred = Array.from(document.querySelectorAll('.archive-pin-thumb[data-src]'));

      const hydrate = (img) => {
        if (!(img instanceof HTMLImageElement)) return;
        const src = img.dataset.src;
        if (!src) return;
        img.src = src;
        delete img.dataset.src;
      };

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            hydrate(entry.target);
            observer.unobserve(entry.target);
          });
        }, { rootMargin: '360px 0px' });
        deferred.forEach((img) => observer.observe(img));
      } else {
        deferred.forEach(hydrate);
      }

      document.querySelectorAll('.archive-pin-thumb').forEach((node) => {
        node.addEventListener('error', () => {
          if (!(node instanceof HTMLImageElement)) return;
          const fallback = node.dataset.fallback;
          if (!fallback || node.src === fallback) return;
          node.src = fallback;
          delete node.dataset.src;
        }, { once: true });
      });

      if (!(dialog instanceof HTMLDialogElement) || !media || !title || !group || !count) return;

      let activeIndex = 0;
      const clearMedia = () => {
        media.replaceChildren();
        delete media.dataset.kind;
      };

      const showPlaybackError = (kind, poster) => {
        const box = document.createElement('div');
        box.className = 'archive-playback-error';
        const img = document.createElement('img');
        img.src = poster || '';
        img.alt = '';
        const text = document.createElement('p');
        text.textContent = kind === 'video' ? 'Video ini belum bisa diputar di browser ini.' : 'Audio ini belum bisa diputar di browser ini.';
        box.append(img, text);
        media.replaceChildren(box);
      };

      const renderAt = (index) => {
        if (!triggers.length) return;
        activeIndex = (index + triggers.length) % triggers.length;
        const trigger = triggers[activeIndex];
        if (!(trigger instanceof HTMLElement)) return;

        clearMedia();
        const kind = trigger.dataset.kind || '';
        const itemTitle = trigger.dataset.title || '';
        const itemGroup = trigger.dataset.group || '';
        const source = trigger.dataset.media || '';
        const poster = trigger.dataset.poster || '';
        media.dataset.kind = kind;
        title.textContent = itemTitle;
        group.textContent = itemGroup;
        count.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(triggers.length).padStart(2, '0')}`;

        if (kind === 'image') {
          const img = document.createElement('img');
          img.src = trigger.dataset.image || '';
          img.alt = `${itemGroup} — ${itemTitle}`;
          img.decoding = 'async';
          media.append(img);
          return;
        }

        if (kind === 'video') {
          const video = document.createElement('video');
          video.className = 'archive-native-video';
          video.src = source;
          video.poster = poster;
          video.controls = true;
          video.autoplay = true;
          video.playsInline = true;
          video.preload = 'metadata';
          video.addEventListener('error', () => showPlaybackError('video', poster), { once: true });
          media.append(video);
          return;
        }

        const stage = document.createElement('div');
        stage.className = 'archive-audio-stage';
        const art = document.createElement('img');
        art.className = 'archive-audio-art';
        art.src = poster;
        art.alt = '';
        const label = document.createElement('div');
        label.className = 'archive-audio-label';
        label.innerHTML = '<span>REKAMAN</span><strong></strong>';
        const labelTitle = label.querySelector('strong');
        if (labelTitle) labelTitle.textContent = itemTitle.replace(/\.[a-z0-9]+$/i, '');
        const audio = document.createElement('audio');
        audio.src = source;
        audio.controls = true;
        audio.autoplay = true;
        audio.preload = 'metadata';
        audio.addEventListener('error', () => showPlaybackError('audio', poster), { once: true });
        stage.append(art, label, audio);
        media.append(stage);
      };

      const openAt = (index) => {
        renderAt(index);
        if (!dialog.open) dialog.showModal();
        document.documentElement.classList.add('archive-viewer-open');
      };

      triggers.forEach((trigger, index) => trigger.addEventListener('click', () => openAt(index)));
      prev?.addEventListener('click', () => renderAt(activeIndex - 1));
      next?.addEventListener('click', () => renderAt(activeIndex + 1));

      const closeViewer = () => {
        clearMedia();
        if (dialog.open) dialog.close();
        document.documentElement.classList.remove('archive-viewer-open');
      };

      close?.addEventListener('click', closeViewer);
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) closeViewer();
      });
      dialog.addEventListener('close', () => {
        clearMedia();
        document.documentElement.classList.remove('archive-viewer-open');
      });
      document.addEventListener('keydown', (event) => {
        if (!dialog.open) return;
        if (event.key === 'ArrowLeft') renderAt(activeIndex - 1);
        if (event.key === 'ArrowRight') renderAt(activeIndex + 1);
      });
    })();
  </script>
</BaseLayout>

<style>
  .archive-drive-masonry {
    columns: 5 220px;
    column-gap: 12px;
    padding-top: 26px;
  }
  .archive-pin {
    break-inside: avoid;
    margin: 0 0 24px;
  }
  .archive-pin-media {
    position: relative;
    width: 100%;
    padding: 0;
    display: block;
    overflow: hidden;
    border: 0;
    background: #121212;
    color: #fff;
    cursor: zoom-in;
    text-align: left;
  }
  .archive-pin--shape-0 .archive-pin-media { aspect-ratio: 4 / 5; }
  .archive-pin--shape-1 .archive-pin-media { aspect-ratio: 1 / 1; }
  .archive-pin--shape-2 .archive-pin-media { aspect-ratio: 3 / 4; }
  .archive-pin--shape-3 .archive-pin-media { aspect-ratio: 16 / 11; }
  .archive-pin--shape-4 .archive-pin-media { aspect-ratio: 5 / 7; }
  .archive-pin-thumb {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    background: #111;
    transition: transform .35s ease, opacity .25s ease;
  }
  .archive-pin-media:hover .archive-pin-thumb { transform: scale(1.025); }
  .archive-kind-badge {
    position: absolute;
    inset: auto 10px 10px auto;
    min-width: 64px;
    padding: 8px 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    background: rgba(5,5,5,.82);
    border: 1px solid rgba(255,255,255,.3);
    backdrop-filter: blur(8px);
    font: 500 8px/1 var(--mono);
    letter-spacing: .07em;
  }
  .archive-kind-badge b { font-size: 12px; font-weight: 500; }
  .archive-pin-meta {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding-top: 8px;
    color: #8d8d8d;
    font: 400 8px/1.25 var(--mono);
  }
  .archive-pin-meta span:first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .archive-viewer {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(0,0,0,.96);
    color: #fff;
  }
  .archive-viewer::backdrop { background: rgba(0,0,0,.92); }
  .archive-viewer-shell {
    width: min(1280px, calc(100vw - 96px));
    min-height: 100dvh;
    margin: 0 auto;
    padding: 62px 0 32px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 320px);
    gap: clamp(20px, 3vw, 44px);
    align-items: center;
  }
  .archive-viewer-media {
    min-height: min(78dvh, 820px);
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #080808;
  }
  .archive-viewer-media[data-kind="audio"] { min-height: 0; background: transparent; }
  .archive-viewer-media img:not(.archive-audio-art) {
    max-width: 100%;
    max-height: 88dvh;
    width: auto;
    height: auto;
    display: block;
    object-fit: contain;
  }
  .archive-native-video {
    width: 100%;
    max-height: 84dvh;
    display: block;
    object-fit: contain;
    background: #000;
  }
  .archive-audio-stage {
    width: min(760px, 100%);
    min-height: min(64dvh, 620px);
    padding: clamp(26px, 5vw, 68px);
    display: grid;
    grid-template-rows: 1fr auto auto;
    gap: 28px;
    background: #0b0b0b;
    border: 1px solid #2d2d2d;
  }
  .archive-audio-art {
    width: min(320px, 58%);
    align-self: center;
    justify-self: center;
    display: block;
    object-fit: contain;
  }
  .archive-audio-label { display: grid; gap: 8px; }
  .archive-audio-label span { color: #888; font: 500 9px/1 var(--mono); letter-spacing: .08em; }
  .archive-audio-label strong { max-width: 14ch; font-size: clamp(30px, 5vw, 68px); line-height: .9; letter-spacing: -.06em; }
  .archive-audio-stage audio { width: 100%; min-height: 44px; }
  .archive-playback-error {
    width: min(620px, 100%);
    padding: 32px;
    display: grid;
    place-items: center;
    gap: 22px;
    border: 1px solid #333;
    text-align: center;
  }
  .archive-playback-error img { width: min(260px, 60%); max-height: 260px; object-fit: contain; }
  .archive-playback-error p { margin: 0; max-width: 34ch; font-size: 16px; line-height: 1.45; }
  .archive-viewer-meta {
    align-self: end;
    padding-bottom: 20px;
    display: grid;
    gap: 10px;
  }
  .archive-viewer-meta span,
  .archive-viewer-meta small {
    color: #999;
    font: 500 9px/1.3 var(--mono);
    letter-spacing: .06em;
  }
  .archive-viewer-meta strong {
    overflow-wrap: anywhere;
    font-size: clamp(24px, 3vw, 44px);
    line-height: .95;
    letter-spacing: -.05em;
  }
  .archive-viewer-close,
  .archive-viewer-nav {
    position: fixed;
    z-index: 4;
    border: 1px solid #555;
    background: rgba(17,17,17,.92);
    color: #fff;
    cursor: pointer;
    font: 500 9px/1 var(--mono);
    backdrop-filter: blur(8px);
  }
  .archive-viewer-close { top: max(14px, env(safe-area-inset-top)); right: max(16px, env(safe-area-inset-right)); padding: 12px 14px; }
  .archive-viewer-nav {
    top: 50%;
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    transform: translateY(-50%);
    font-size: 18px;
  }
  .archive-viewer-prev { left: 16px; }
  .archive-viewer-next { right: 16px; }
  :global(html.archive-viewer-open) { overflow: hidden; }

  @media (max-width: 760px) {
    .archive-drive-masonry {
      columns: 2 150px;
      column-gap: 8px;
      padding: 18px 10px 90px;
    }
    .archive-pin { margin-bottom: 18px; }
    .archive-pin-meta { font-size: 7px; }
    .archive-pin-meta span:first-child { max-width: 68%; }
    .archive-viewer-shell {
      width: calc(100vw - 20px);
      min-height: 100dvh;
      padding: calc(56px + env(safe-area-inset-top)) 0 calc(76px + env(safe-area-inset-bottom));
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
      gap: 14px;
      align-content: stretch;
    }
    .archive-viewer-media { min-height: 0; max-height: 72dvh; }
    .archive-viewer-media[data-kind="audio"] { max-height: none; align-self: center; }
    .archive-native-video { max-height: 70dvh; }
    .archive-audio-stage {
      min-height: min(56dvh, 520px);
      padding: 24px;
      gap: 20px;
    }
    .archive-audio-art { width: min(260px, 62%); }
    .archive-viewer-meta {
      align-self: auto;
      padding: 0 4px;
      gap: 7px;
    }
    .archive-viewer-meta strong { font-size: clamp(24px, 8vw, 38px); }
    .archive-viewer-close { top: max(9px, env(safe-area-inset-top)); right: 10px; }
    .archive-viewer-nav {
      top: auto;
      bottom: max(14px, env(safe-area-inset-bottom));
      transform: none;
    }
    .archive-viewer-prev { left: 10px; }
    .archive-viewer-next { right: 10px; }
  }

  @media (max-width: 340px) {
    .archive-drive-masonry { columns: 1; padding-inline: 12px; }
  }

  @media (hover: none), (pointer: coarse) {
    .archive-pin-media:hover .archive-pin-thumb { transform: none; }
  }
</style>
