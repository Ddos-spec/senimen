---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaSlot from '../components/MediaSlot.astro';
import { carouselSlides } from '../data/media';
---
<BaseLayout title="Arsip Visual — SENIMEN" description="193 frame dokumentasi visual SENIMEN dari arsip komunitas seni dan kreatif independen Tangerang." image="images/carousel_all/slide_108.jpg">
  <main class="page archive-page">
    <section class="route-hero">
      <div class="route-hero-grid">
        <div><span class="page-kicker">ARSIP / 193 FRAME</span><h1 class="page-title">LIVING<br /><em>ARCHIVE.</em></h1></div>
        <p class="page-lead">Bukan sepuluh gambar dekoratif. Koleksi foto yang sudah dikumpulkan masuk ke satu index visual lengkap dan tetap lazy-load supaya halaman tidak membebani browser sekaligus.</p>
      </div>
      <div class="route-count">193 BERKAS / CAROUSEL ALL / SENIMEN</div>
    </section>

    <div class="archive-toolbar"><span>ALL FRAMES / 001—193</span><span>SCROLL TO BROWSE</span></div>

    <section class="archive-masonry" aria-label="193 dokumentasi visual SENIMEN">
      {carouselSlides.map((frame, index) => (
        <figure class="archive-item">
          <MediaSlot src={frame.src} alt={frame.alt} />
          <figcaption><span>{frame.label}</span><span>{String(index + 1).padStart(3, '0')} / 193</span></figcaption>
        </figure>
      ))}
    </section>
  </main>
</BaseLayout>
