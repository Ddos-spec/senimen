---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles, type Article } from '../../data/articles';

export function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

interface Props { article: Article }
const { article } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const generatedCovers: Record<string, string> = {
  'dokumentasi-proses-seni': 'images/articles/dokumentasi-proses-seni.webp',
  'artist-statement-tanpa-basa-basi': 'images/articles/artist-statement.webp',
  'brief-kolaborasi-kreatif': 'images/articles/brief-kolaborasi-kreatif.webp',
  'membangun-arsip-kolektif': 'images/articles/arsip-kolektif.webp',
  'mendokumentasikan-event-seni': 'images/articles/dokumentasi-event-seni.webp',
  'portofolio-seniman-sebagai-cerita': 'images/articles/portofolio-seniman.webp',
};
const articleCover = `${base}${generatedCovers[article.slug] ?? article.cover}`;
const articleFallback = `${base}${article.cover}`;
---
<BaseLayout title={`${article.title} — SENIMEN`} description={article.excerpt} image={articleCover}>
  <main class="page article-page">
    <article>
      <header class="article-hero">
        <div class="article-hero-meta"><a href={`${base}articles/`}>← SEMUA ARTIKEL</a><span>{article.eyebrow} · {article.readingTime}</span></div>
        <h1>{article.title}</h1>
        <p class="article-deck">{article.excerpt}</p>
      </header>

      <div class="article-cover">
        <img
          src={articleCover}
          data-fallback={articleFallback}
          alt={article.title}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          onerror="this.onerror=null;this.src=this.dataset.fallback"
        />
      </div>

      <div class="article-body">
        {article.sections.map((section, index) => (
          <section class="article-section">
            <div><span class="page-kicker">{String(index + 1).padStart(2, '0')} / {article.eyebrow}</span><h2>{section.heading}</h2></div>
            <div class="article-section-copy">
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
            </div>
          </section>
        ))}
      </div>
    </article>
  </main>
</BaseLayout>
