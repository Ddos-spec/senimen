---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles, type Article } from '../../data/articles';
import { articleCovers } from '../../data/articleCovers';

export function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

interface Props { article: Article }
const { article } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const articleCover = articleCovers[article.slug] ?? `${base}${article.cover}`;
---
<BaseLayout title={`${article.title} — SENIMEN`} description={article.excerpt} image={articleCover}>
  <main class="page article-page">
    <article>
      <header class="article-hero">
        <div class="article-hero-meta"><a href={`${base}articles/`}>← SEMUA ARTIKEL</a><span>{article.eyebrow} · {article.readingTime}</span></div>
        <h1>{article.title}</h1>
        <p class="article-deck">{article.excerpt}</p>
      </header>

      <div class="article-cover article-cover--full">
        <img
          src={articleCover}
          alt={article.title}
          width="1448"
          height="1086"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>

      <div class="article-body">
        {article.sections.map((section, index) => (
          <section class="article-section">
            <div><span class="page-kicker">{String(index + 1).padStart(2, '0')} / {article.eyebrow}</span><h2>{section.heading}</h2></div>
            <div class="article-section-copy">
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
            </div>
          </section>
        ))}
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .article-cover--full {
    height: auto !important;
    aspect-ratio: auto !important;
    overflow: visible !important;
    background: #111;
  }
  .article-cover--full img {
    width: 100%;
    height: auto !important;
    max-height: none !important;
    display: block;
    object-fit: contain !important;
    object-position: center;
  }
</style>
