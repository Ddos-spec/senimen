---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../data/articles';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="Artikel — SENIMEN" description="Catatan SENIMEN soal dokumentasi, arsip, kolaborasi, event, artist statement, dan portofolio.">
  <main class="page articles-page">
    <section class="route-hero">
      <div class="route-hero-grid">
        <div><span class="page-kicker">BACA / CATAT / PAKAI</span><h1 class="page-title">CATATAN<br />SENIMEN.</h1></div>
        <p class="page-lead">Hal-hal yang biasanya baru kepikiran setelah kejadian: nyusun arsip, nulis statement, bikin brief, dokumentasi acara, sampai beresin portofolio.</p>
      </div>
      <div class="route-count">{String(articles.length).padStart(2, '0')} TULISAN</div>
    </section>

    <section class="articles-index">
      <div class="articles-list">
        {articles.map((article, index) => (
          <a class="article-row" href={`${base}articles/${article.slug}/`}>
            <span class="article-row-no">{String(index + 1).padStart(2, '0')}</span>
            <h2>{article.title}</h2>
            <p>{article.excerpt}</p>
            <span class="article-arrow">↗</span>
            <span class="article-row-meta">{article.eyebrow} · {article.readingTime}</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
