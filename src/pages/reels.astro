---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getReels } from '../data/media';
const reels = await getReels();
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="Reels Archive — SENIMEN" description="Moving image dan dokumentasi video SENIMEN.">
  <main class="page reels-page">
    <section class="route-hero">
      <div class="route-hero-grid">
        <div><span class="page-kicker">MOVING IMAGE / REELS</span><h1 class="page-title">REELS<br />ARCHIVE.</h1></div>
        <p class="page-lead">Video dipisahkan dari galeri foto supaya ritmenya tidak dipaksa jadi satu feed. File MP4 dibaca otomatis dari folder media saat Astro build.</p>
      </div>
      <div class="route-count">{reels.length} VIDEO TERDETEKSI</div>
    </section>

    {reels.length > 0 ? (
      <section class="reels-grid" aria-label="Video reels SENIMEN">
        {reels.map((reel, index) => (
          <figure class="reel-card">
            <video
              src={`${base}${reel.src}`}
              muted
              loop
              playsinline
              controls
              preload={index < 8 ? 'metadata' : 'none'}
              aria-label={`Dokumentasi video SENIMEN ${index + 1}`}
            ></video>
            <figcaption><span>{reel.label}</span><span>{reel.file}</span></figcaption>
          </figure>
        ))}
      </section>
    ) : (
      <section class="reels-empty">
        <strong>FOLDER VIDEO BELUM MASUK MAIN.</strong>
        <p>Halaman ini sudah siap dan auto-discovery sudah aktif, tetapi build saat ini tidak menemukan <code>public/videos/reels/</code>. Begitu file MP4 masuk ke branch main, daftar video akan muncul otomatis pada deploy berikutnya.</p>
      </section>
    )}
  </main>
</BaseLayout>
