---
import BaseLayout from '../layouts/BaseLayout.astro';
import { social } from '../data/site';
import { brand } from '../data/brand';
const transparentPixel = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==';
---
<BaseLayout title="Gabung — SENIMEN" description="Kontak SENIMEN untuk kirim karya, masukin dokumentasi ke arsip, atau membahas acara dan kolaborasi." image={brand.collab}>
  <main class="page join-page">
    <section class="route-hero join-hero">
      <div class="route-hero-grid join-hero-grid">
        <div>
          <span class="page-kicker">GABUNG / SENIMEN</span>
          <h1 class="page-title">GABUNG<br />SENIMEN.</h1>
          <p class="page-lead join-lead">Mau kirim karya, masukin dokumentasi ke arsip, ngajak bikin acara, atau bahas kolaborasi? Pilih kontak yang paling sesuai di bawah.</p>
        </div>
        <figure class="join-brand-hero reveal-card">
          <img src={brand.collab} alt="Kolaborasi SENIMEN" width="720" height="720" loading="eager" fetchpriority="high" decoding="async" />
        </figure>
      </div>
      <img class="join-scrap join-scrap--one" src={brand.tanyaTanya} alt="" aria-hidden="true" width="480" height="480" loading="lazy" decoding="async" />
      <img class="join-scrap join-scrap--two" src={brand.balikLayar} alt="" aria-hidden="true" width="480" height="480" loading="lazy" decoding="async" />
    </section>

    <section class="join-actions">
      <div><span class="page-kicker">KONTAK & SUBMISI</span><h2>PILIH<br />JALURNYA.</h2></div>
      <div class="join-links">
        <a class="join-link" data-cursor="BUKA" href={social.instagram} target="_blank" rel="noreferrer"><span>INSTAGRAM</span><span>↗</span></a>
        <a class="join-link" data-cursor="KIRIM" href={social.submit} target="_blank" rel="noreferrer"><span>KIRIM KARYA / ARSIP</span><span>↗</span></a>
        <a class="join-link" data-cursor="CHAT" href={social.whatsapp} target="_blank" rel="noreferrer"><span>WHATSAPP</span><span>↗</span></a>
        <a class="join-link" data-cursor="KIRIM" href={`mailto:${social.email}`}><span>EMAIL</span><span>↗</span></a>
      </div>
    </section>

    <section class="join-brand-grid" aria-label="Aset resmi SENIMEN">
      <figure class="join-brand-card">
        <img src={transparentPixel} data-defer-src={brand.joinQr} alt="QR untuk bergabung dengan SENIMEN" width="520" height="520" loading="lazy" decoding="async" fetchpriority="low" />
        <noscript><img src={brand.joinQr} alt="QR untuk bergabung dengan SENIMEN" loading="lazy" decoding="async" /></noscript>
        <figcaption>QR GABUNG SENIMEN</figcaption>
      </figure>
      <a class="join-brand-card" data-cursor="KIRIM" href={social.submit} target="_blank" rel="noreferrer">
        <img src={transparentPixel} data-defer-src={brand.submitQr} alt="QR untuk mengirim karya ke SENIMEN" width="520" height="520" loading="lazy" decoding="async" fetchpriority="low" />
        <noscript><img src={brand.submitQr} alt="QR untuk mengirim karya ke SENIMEN" loading="lazy" decoding="async" /></noscript>
        <span class="join-brand-caption">QR KIRIM KARYA / ARSIP ↗</span>
      </a>
    </section>
  </main>
</BaseLayout>

<style>
  .join-hero-grid { align-items: center; }
  .join-lead { margin-top: 34px; max-width: 28ch; }
  .join-brand-hero {
    margin: 0;
    justify-self: end;
    width: min(34vw, 430px);
    border: 1px solid var(--senimen-black);
    transform: rotate(1.2deg);
    overflow: hidden;
  }
  .join-brand-hero img { width: 100%; height: auto; display: block; }

  .join-brand-grid {
    padding: 0 var(--page-pad) clamp(90px, 11vw, 150px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    max-width: 1200px;
  }
  .join-brand-card {
    margin: 0;
    display: block;
    border: 1px solid var(--senimen-black);
    background: var(--senimen-black);
    color: var(--senimen-white);
    overflow: hidden;
  }
  .join-brand-card img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }
  .join-brand-card figcaption,
  .join-brand-caption {
    display: flex;
    min-height: 52px;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
    border-top: 1px solid #333;
    font: 500 9px/1 var(--mono);
    letter-spacing: .06em;
  }
  @media (max-width: 760px) {
    .join-hero-grid { gap: 34px; }
    .join-brand-hero { width: min(78vw, 380px); justify-self: start; }
    .join-brand-grid { grid-template-columns: 1fr; padding-inline: 18px; gap: 12px; }
  }
</style>
