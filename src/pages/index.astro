---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import FeaturedArchive from '../components/FeaturedArchive.astro';
import EducationTeaser from '../components/EducationTeaser.astro';
import { ticker } from '../data/site';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const marquee = [...ticker, 'SKETSA', 'OBROLAN', 'ACARA', ...ticker, 'PROSES', 'CATATAN', 'KARYA'];
---
<BaseLayout>
  <main class="page">
    <HomeHero />

    <section class="home-marquee" aria-label="Isi SENIMEN">
      <div class="home-marquee-track">{marquee.map((item) => <><span>{item}</span><span>✦</span></>)}</div>
    </section>

    <section class="home-intro">
      <div class="page-kicker">01 / TENTANG SENIMEN</div>
      <div>
        <h2>KARYA, PROSES, DAN KEGIATAN DI SATU ARSIP.</h2>
        <div class="home-intro-copy">Di sini ada dokumentasi acara, karya anggota, sketsa, rekaman, potongan video, dan materi proses lain. Sebagian sudah selesai, sebagian masih berjalan. Semuanya disimpan supaya konteksnya tetap bisa dicari lagi.</div>
      </div>
    </section>

    <FeaturedArchive />

    <section class="pink-manifesto"><p>KARYA.<br />PROSES.<br /><em>ARSIP.</em></p></section>

    <EducationTeaser />

    <section class="route-hero" style="background:#f70bbd;border-bottom:0">
      <div class="route-hero-grid">
        <div><span class="page-kicker">04 / GABUNG</span><h2 class="page-title">GABUNG<br />SENIMEN.</h2></div>
        <div><p class="page-lead">Mau kirim karya, masukin dokumentasi ke arsip, ngajak kolaborasi, atau ngobrol soal acara? Pilih jalurnya di halaman gabung.</p><div style="margin-top:28px"><a class="action-link magnetic" href={`${base}join/`}>LIHAT CARA GABUNG ↗</a></div></div>
      </div>
    </section>
  </main>
</BaseLayout>
