---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { brand } from '../data/brand';
import '../../styles.css';
import '../../brand.css';
import '../../media.css';
import '../styles/rebuild.css';
import '../styles/mobile.css';
import '../styles/archive-drive.css';
import '../styles/mobile-polish.css';
import '../styles/performance.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'SENIMEN — Komunitas Seni & Kreatif Independen',
  description = 'SENIMEN adalah ruang seni independen di Tangerang untuk karya, arsip, acara, obrolan, dan kolaborasi.',
  image,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const socialImage = image
  ? (image.startsWith('http') ? new URL(image) : new URL(`${base}${image.replace(/^\/+/, '')}`, Astro.site))
  : new URL(brand.og);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'SENIMEN',
  description,
  url: canonical.origin,
  email: 'senimenuntukseni@gmail.com',
  sameAs: [
    'https://www.instagram.com/komunitas_senimen/',
    'https://www.tiktok.com/@komunitas_senimen',
    'https://www.threads.net/@komunitas_senimen',
  ],
  areaServed: 'Tangerang, Banten, Indonesia',
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f70bbd" />
    <meta name="color-scheme" content="light" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://drive.google.com https://*.googleusercontent.com; media-src 'self' blob: https://drive.google.com https://drive.usercontent.google.com https://*.googleusercontent.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
    />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="SENIMEN — Komunitas Seni & Kreatif Independen" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={brand.favicon} />
    <link rel="apple-touch-icon" href={brand.logo} />
    <link rel="preconnect" href="https://drive.google.com" crossorigin />
    <link rel="dns-prefetch" href="https://drive.google.com" />
    <link rel="preconnect" href="https://drive.usercontent.google.com" crossorigin />
    <link rel="dns-prefetch" href="https://drive.usercontent.google.com" />
    <link rel="preconnect" href="https://lh3.googleusercontent.com" crossorigin />
    <link rel="dns-prefetch" href="https://lh3.googleusercontent.com" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <div class="noise" aria-hidden="true"></div>
    <div class="cursor" aria-hidden="true"><span></span></div>
    <div class="progress" aria-hidden="true"><i></i></div>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
