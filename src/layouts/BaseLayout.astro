---
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../../styles.css';
import '../../brand.css';
import '../../media.css';
import '../styles/rebuild.css';
import '../styles/mobile.css';
import '../styles/archive-drive.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'SENIMEN — Komunitas Seni & Kreatif Independen',
  description = 'SENIMEN — Komunitas Seni & Kreatif Independen di Tangerang. Dokumentasi proses, perspektif, ekspresi, kolaborasi, arsip visual, dan tulisan edukasi.',
  image,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const socialImage = image ? (image.startsWith('http') ? new URL(image) : new URL(`${base}${image.replace(/^\/+/, '')}`, Astro.site)) : undefined;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'SENIMEN',
  description,
  url: canonical.origin,
  email: 'senimenuntukseni@gmail.com',
  sameAs: [
    'https://www.instagram.com/komunitas_senimen/',
    'https://www.tiktok.com/@komunitas_senimen',
    'https://www.threads.net/@komunitas_senimen',
  ],
  areaServed: 'Tangerang, Banten, Indonesia',
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f70bbd" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <div class="noise" aria-hidden="true"></div>
    <div class="cursor" aria-hidden="true"><span></span></div>
    <div class="progress" aria-hidden="true"><i></i></div>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
