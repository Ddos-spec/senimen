---
import GraffitiWord from './GraffitiWord.astro';
import { featuredMedia } from '../data/media';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const heroThumb = (width: number) => `https://drive.google.com/thumbnail?id=1_IjAQmZm15H76AhCTxqcunfsd18qPn_S&sz=w${width}`;
const archiveThumb = (id: string, width: number) => `https://drive.google.com/thumbnail?id=${id}&sz=w${width}`;
const heroImage = heroThumb(640);
const heroSrcset = `${heroThumb(420)} 420w, ${heroThumb(560)} 560w, ${heroThumb(640)} 640w, ${heroThumb(800)} 800w`;
const scraps = featuredMedia.slice(0, 2);
---

<section class="hero-classic hero-artboard" aria-labelledby="senimen-home-title">
  <div class="hero-classic-meta">
    <span>KOMUNITAS SENI & KREATIF INDEPENDEN</span>
    <span>TANGERANG / INDONESIA</span>
  </div>

  <div class="hero-classic-stage">
    <div class="hero-margin-note hero-margin-note--left" aria-hidden="true">ARSIP DIGITAL / 2026</div>
    <div class="hero-margin-note hero-margin-note--right" aria-hidden="true">KARYA · PROSES · ACARA</div>

    <h1 id="senimen-home-title" class="hero-classic-title" aria-label="SENIMEN" transition:name="home-title">
      <span class="sr-only">SENIMEN</span>
      <span class="graffiti-lockup graffiti-lockup--seni" aria-hidden="true"><GraffitiWord word="SENI" tone="black" /></span>
      <span class="graffiti-lockup graffiti-lockup--men" aria-hidden="true"><GraffitiWord word="MEN" tone="pink" /></span>
    </h1>

    {scraps[0] && (
      <figure class="hero-scrap hero-scrap--a" data-speed="-0.018" aria-hidden="true">
        <img src={archiveThumb(scraps[0].id, 360)} alt="" width="360" height="450" loading="eager" decoding="async" />
        <figcaption>{scraps[0].group}</figcaption>
      </figure>
    )}

    <div class="hero-classic-poster reveal-card" data-cursor="LIHAT">
      <img
        src={heroImage}
        srcset={heroSrcset}
        sizes="(max-width: 760px) 78vw, (max-width: 1100px) 36vw, 465px"
        alt="Dokumentasi SENIMEN"
        width="640"
        height="853"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <div class="hero-poster-label"><span>ARSIP / SENIMEN</span><span>TANGERANG</span></div>
      <span class="hero-tape hero-tape--one" aria-hidden="true"></span>
      <span class="hero-tape hero-tape--two" aria-hidden="true"></span>
    </div>

    {scraps[1] && (
      <figure class="hero-scrap hero-scrap--b" data-speed="0.014" aria-hidden="true">
        <img src={archiveThumb(scraps[1].id, 320)} alt="" width="320" height="400" loading="lazy" decoding="async" />
        <figcaption>{scraps[1].group}</figcaption>
      </figure>
    )}

    <div class="hero-classic-stamp" aria-hidden="true">
      <span>KARYA</span><span>ARSIP</span><span>ACARA</span>
    </div>

    <div class="hero-index-card" aria-hidden="true">
      <b>INDEX</b>
      <span>001—006</span>
      <i></i>
      <span>SCROLL ↓</span>
    </div>
  </div>

  <div class="hero-classic-bottom">
    <p>SENIMEN adalah komunitas seni dan kreatif independen di Tangerang. Website ini mengumpulkan karya, dokumentasi kegiatan, dan materi proses dari komunitas.</p>
    <div class="hero-classic-actions">
      <a class="hero-round-link magnetic" data-cursor="BUKA" href={`${base}archive/`} aria-label="Masuk ke arsip SENIMEN"><span>ARSIP</span><b>↓</b></a>
      <a class="hero-text-link" data-cursor="BACA" href={`${base}articles/`}>ARTIKEL ↗</a>
    </div>
  </div>
</section>

<style>
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }

  .hero-artboard {
    --hero-line: rgba(5,5,5,.17);
    min-height: calc(100svh - 78px);
    padding: clamp(28px, 3vw, 48px) var(--page-pad) clamp(38px, 4vw, 58px);
    display:grid;
    grid-template-rows:auto 1fr auto;
    gap:28px;
    overflow:hidden;
    background:
      linear-gradient(90deg, transparent calc(25% - .5px), var(--hero-line) 25%, transparent calc(25% + .5px), transparent calc(75% - .5px), var(--hero-line) 75%, transparent calc(75% + .5px)),
      var(--senimen-white);
  }
  .hero-classic-meta {
    display:flex;
    justify-content:space-between;
    gap:20px;
    position:relative;
    z-index:12;
    font:500 10px/1 var(--mono);
    letter-spacing:.08em;
  }
  .hero-classic-stage {
    min-height:clamp(620px,69vh,760px);
    position:relative;
    display:grid;
    place-items:center;
    isolation:isolate;
  }
  .hero-classic-title { position:absolute; inset:0; z-index:6; margin:0; pointer-events:none; }

  .graffiti-lockup { position:absolute; display:block; filter:drop-shadow(0 1px 0 rgba(0,0,0,.06)); }
  .graffiti-lockup--seni {
    width:min(52vw,790px);
    left:-1.2vw;
    top:4%;
    transform:rotate(-7deg) skewX(-3deg);
    transform-origin:20% 50%;
  }
  .graffiti-lockup--men {
    width:min(42vw,640px);
    right:-.8vw;
    bottom:1%;
    transform:rotate(6deg) skewX(2deg);
    transform-origin:80% 50%;
  }

  .hero-margin-note {
    position:absolute;
    z-index:2;
    top:50%;
    font:500 8px/1 var(--mono);
    letter-spacing:.12em;
    color:#777;
    writing-mode:vertical-rl;
  }
  .hero-margin-note--left { left:-2px; transform:translateY(-50%) rotate(180deg); }
  .hero-margin-note--right { right:-2px; transform:translateY(-50%); }

  .hero-classic-poster {
    position:relative;
    z-index:4;
    width:min(30vw,465px);
    min-width:300px;
    overflow:visible;
    background:#ececea;
    transform:rotate(-2deg);
    box-shadow:0 24px 70px rgba(0,0,0,.14);
  }
  .hero-classic-poster > img { width:100%; aspect-ratio:3/4; display:block; object-fit:cover; }
  .hero-poster-label { position:absolute; inset:auto 12px 12px; z-index:3; display:flex; justify-content:space-between; gap:10px; padding:8px 9px; background:rgba(5,5,5,.82); color:#fff; font:500 8px/1 var(--mono); }
  .hero-tape {
    position:absolute;
    z-index:5;
    width:76px;
    height:22px;
    background:rgba(247,11,189,.86);
    border:1px solid rgba(5,5,5,.25);
    box-shadow:0 3px 8px rgba(0,0,0,.08);
    mix-blend-mode:multiply;
  }
  .hero-tape--one { left:-30px; top:12%; transform:rotate(-15deg); }
  .hero-tape--two { right:-28px; bottom:18%; transform:rotate(13deg); background:rgba(235,235,225,.9); }

  .hero-scrap {
    position:absolute;
    z-index:3;
    margin:0;
    background:#fff;
    border:1px solid var(--senimen-black);
    padding:6px 6px 22px;
    box-shadow:0 16px 34px rgba(0,0,0,.09);
    will-change:transform;
  }
  .hero-scrap img { width:100%; height:100%; display:block; object-fit:cover; filter:grayscale(1) contrast(1.04); }
  .hero-scrap figcaption { position:absolute; inset:auto 7px 6px; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; font:500 7px/1 var(--mono); letter-spacing:.05em; }
  .hero-scrap--a { width:min(17vw,230px); aspect-ratio:4/5; left:8%; bottom:9%; transform:rotate(5deg); }
  .hero-scrap--b { width:min(14vw,190px); aspect-ratio:1/1.2; right:10%; top:14%; transform:rotate(-6deg); }

  .hero-classic-stamp {
    position:absolute;
    z-index:9;
    right:1.5%;
    top:0;
    width:96px;
    height:96px;
    border:1px solid var(--senimen-black);
    border-radius:50%;
    background:var(--senimen-pink);
    display:grid;
    place-content:center;
    text-align:center;
    transform:rotate(10deg);
    font:600 9px/1.25 var(--mono);
    animation:stampFloat 5.5s ease-in-out infinite;
  }
  .hero-classic-stamp span { display:block; }
  @keyframes stampFloat { 50% { transform:rotate(6deg) translateY(-7px); } }

  .hero-index-card {
    position:absolute;
    z-index:8;
    left:2.2%;
    top:9%;
    width:112px;
    padding:10px;
    display:grid;
    gap:7px;
    border:1px solid var(--senimen-black);
    background:rgba(255,255,255,.91);
    font:500 7px/1 var(--mono);
    letter-spacing:.08em;
    transform:rotate(-2deg);
  }
  .hero-index-card b { font-weight:600; }
  .hero-index-card i { display:block; height:1px; background:var(--senimen-black); }

  .hero-classic-bottom {
    position:relative;
    z-index:10;
    display:grid;
    grid-template-columns:minmax(280px,720px) auto;
    gap:48px;
    align-items:end;
    padding-top:10px;
  }
  .hero-classic-bottom p {
    margin:0;
    max-width:690px;
    font-size:clamp(18px,1.7vw,27px);
    line-height:1.34;
    letter-spacing:-.035em;
  }
  .hero-classic-actions { display:flex; align-items:flex-end; gap:20px; }
  .hero-round-link {
    width:96px;
    height:96px;
    border:1px solid var(--senimen-black);
    border-radius:50%;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    gap:8px;
    font:500 10px/1 var(--mono);
    transition:background .2s ease,color .2s ease,transform .2s ease;
  }
  .hero-round-link:hover { background:var(--senimen-black); color:var(--senimen-white); transform:rotate(-5deg); }
  .hero-round-link b { font-size:20px; font-weight:400; }
  .hero-text-link { padding-bottom:5px; border-bottom:1px solid currentColor; font:500 10px/1 var(--mono); }

  @media (max-width:1100px) {
    .hero-classic-stage { min-height:590px; }
    .graffiti-lockup--seni { width:min(55vw,650px); top:8%; }
    .graffiti-lockup--men { width:min(46vw,540px); bottom:5%; }
    .hero-classic-poster { width:min(36vw,420px); min-width:280px; }
    .hero-classic-stamp { width:82px; height:82px; font-size:8px; }
    .hero-scrap--a { left:3%; }
    .hero-scrap--b { right:5%; }
  }

  @media (max-width:760px) {
    .hero-artboard { min-height:auto; padding:24px 18px 44px; gap:24px; background:var(--senimen-white); }
    .hero-classic-meta { font-size:8px; line-height:1.35; }
    .hero-classic-meta span:last-child { text-align:right; }
    .hero-classic-stage { min-height:0; display:grid; grid-template-rows:auto auto auto; gap:10px; place-items:stretch; }
    .hero-classic-title { position:relative; inset:auto; min-height:196px; z-index:6; }
    .graffiti-lockup--seni { width:88%; left:-2%; top:2px; transform:rotate(-8deg) skewX(-3deg); }
    .graffiti-lockup--men { width:72%; right:-1%; bottom:0; transform:rotate(7deg) skewX(2deg); }
    .hero-classic-poster { grid-row:2; width:min(76vw,330px); min-width:0; justify-self:center; margin-top:-8px; transform:rotate(-1.5deg); }
    .hero-classic-stamp { top:34%; right:2px; width:64px; height:64px; font-size:6.5px; }
    .hero-margin-note, .hero-index-card { display:none; }
    .hero-scrap { padding:4px 4px 17px; box-shadow:0 10px 24px rgba(0,0,0,.09); }
    .hero-scrap figcaption { font-size:6px; bottom:5px; }
    .hero-scrap--a { width:28vw; left:0; bottom:4%; transform:rotate(5deg) !important; }
    .hero-scrap--b { width:25vw; right:0; top:46%; transform:rotate(-6deg) !important; }
    .hero-classic-bottom { grid-template-columns:1fr; gap:20px; padding-top:4px; }
    .hero-classic-bottom p { max-width:31ch; font-size:18px; line-height:1.42; }
    .hero-classic-actions { width:100%; justify-content:space-between; align-items:center; }
    .hero-round-link { width:80px; height:80px; }
  }

  @media (max-width:420px) {
    .hero-artboard { padding-inline:15px; }
    .hero-classic-meta span:first-child { max-width:170px; }
    .hero-classic-title { min-height:184px; }
    .graffiti-lockup--seni { width:94%; left:-4%; }
    .graffiti-lockup--men { width:76%; right:-2%; }
    .hero-classic-poster { width:min(78vw,310px); }
    .hero-classic-stamp { width:60px; height:60px; }
    .hero-scrap--a { width:30vw; left:-2px; }
    .hero-scrap--b { width:27vw; right:-2px; }
    .hero-classic-bottom p { max-width:100%; font-size:17px; }
  }

  @media (prefers-reduced-motion:reduce) {
    .hero-classic-stamp { animation:none; }
  }
</style>
