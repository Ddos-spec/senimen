---
import MediaSlot from './MediaSlot.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section class="hero-classic" aria-labelledby="senimen-home-title">
  <div class="hero-classic-meta">
    <span>KOMUNITAS SENI & KREATIF INDEPENDEN</span>
    <span>TANGERANG / INDONESIA</span>
  </div>

  <div class="hero-classic-stage">
    <h1 id="senimen-home-title" class="hero-classic-title" aria-label="SENIMEN" transition:name="home-title">
      <span class="hero-word hero-word--seni">SENI</span>
      <span class="hero-word hero-word--men">MEN</span>
    </h1>

    <div class="hero-classic-poster reveal-card">
      <MediaSlot
        src="images/carousel_all/slide_20.jpg"
        alt="Dokumentasi visual SENIMEN"
        priority={true}
        labelLeft="SENIMEN / ARCHIVE"
        labelRight="TANGERANG"
      />
    </div>

    <div class="hero-classic-stamp" aria-hidden="true">
      <span>KOLAB</span>
      <span>TUMBUH</span>
      <span>BARENG</span>
    </div>
  </div>

  <div class="hero-classic-bottom">
    <p>
      Wadah untuk para seniman. Dokumentasi proses, perspektif, ekspresi, dan kolaborasi—dibangun sebagai ruang untuk bertemu, berkarya, dan tumbuh bareng.
    </p>

    <div class="hero-classic-actions">
      <a class="hero-round-link magnetic" href={`${base}archive/`} aria-label="Masuk ke arsip SENIMEN">
        <span>MASUK</span>
        <b>↓</b>
      </a>
      <a class="hero-text-link" href={`${base}articles/`}>BACA ARTIKEL ↗</a>
    </div>
  </div>
</section>

<style>
  .hero-classic {
    min-height: calc(100svh - 78px);
    padding: clamp(26px, 3vw, 46px) var(--page-pad) clamp(34px, 4vw, 56px);
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 22px;
    overflow: hidden;
    background: var(--senimen-white);
  }

  .hero-classic-meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    position: relative;
    z-index: 8;
    font: 500 10px/1 var(--mono);
    letter-spacing: .08em;
  }

  .hero-classic-stage {
    min-height: 560px;
    position: relative;
    display: grid;
    place-items: center;
  }

  .hero-classic-title {
    position: absolute;
    inset: 50% 0 auto;
    z-index: 5;
    margin: 0;
    transform: translateY(-50%);
    font-size: clamp(118px, 22vw, 330px);
    line-height: .62;
    letter-spacing: -.11em;
    font-weight: 900;
    text-transform: uppercase;
    pointer-events: none;
  }

  .hero-word { display: block; }
  .hero-word--seni { text-align: left; }
  .hero-word--men { text-align: right; padding-right: .055em; }

  .hero-classic-poster {
    position: relative;
    z-index: 3;
    width: min(34vw, 520px);
    min-width: 320px;
    transform: rotate(-2.1deg);
    box-shadow: 0 24px 70px rgba(0,0,0,.14);
  }

  .hero-classic-poster :global(.media-slot) {
    width: 100%;
    aspect-ratio: 3 / 4;
  }

  .hero-classic-stamp {
    position: absolute;
    z-index: 7;
    right: 1.8%;
    top: 2%;
    width: 96px;
    height: 96px;
    border: 1px solid var(--senimen-black);
    border-radius: 50%;
    background: var(--senimen-pink);
    display: grid;
    place-content: center;
    text-align: center;
    transform: rotate(7deg);
    font: 600 9px/1.25 var(--mono);
  }

  .hero-classic-stamp span { display: block; }

  .hero-classic-bottom {
    position: relative;
    z-index: 9;
    display: grid;
    grid-template-columns: minmax(280px, 720px) auto;
    gap: 40px;
    align-items: end;
  }

  .hero-classic-bottom p {
    margin: 0;
    max-width: 690px;
    font-size: clamp(18px, 1.7vw, 27px);
    line-height: 1.3;
    letter-spacing: -.035em;
  }

  .hero-classic-actions {
    display: flex;
    align-items: flex-end;
    gap: 18px;
  }

  .hero-round-link {
    width: 96px;
    height: 96px;
    border: 1px solid var(--senimen-black);
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 8px;
    font: 500 10px/1 var(--mono);
    transition: background .2s ease, color .2s ease;
  }

  .hero-round-link:hover { background: var(--senimen-black); color: var(--senimen-white); }
  .hero-round-link b { font-size: 20px; font-weight: 400; }
  .hero-text-link { padding-bottom: 5px; border-bottom: 1px solid currentColor; font: 500 10px/1 var(--mono); }

  @media (max-width: 1000px) {
    .hero-classic-stage { min-height: 500px; }
    .hero-classic-title { font-size: clamp(110px, 23vw, 230px); }
    .hero-classic-poster { width: min(42vw, 440px); min-width: 290px; }
    .hero-classic-stamp { width: 82px; height: 82px; font-size: 8px; }
  }

  @media (max-width: 760px) {
    .hero-classic {
      min-height: auto;
      padding: 26px 18px 48px;
      gap: 24px;
    }

    .hero-classic-meta {
      font-size: 8px;
      line-height: 1.35;
    }

    .hero-classic-meta span:last-child { text-align: right; }

    .hero-classic-stage {
      min-height: 0;
      display: grid;
      grid-template-rows: auto auto;
      gap: 18px;
      place-items: stretch;
    }

    .hero-classic-title {
      position: relative;
      inset: auto;
      transform: none;
      z-index: 5;
      font-size: clamp(84px, 27vw, 148px);
      line-height: .7;
    }

    .hero-word--men { text-align: left; margin-left: 14vw; padding-right: 0; color: var(--senimen-pink); }

    .hero-classic-poster {
      grid-row: 2;
      width: min(82vw, 430px);
      min-width: 0;
      justify-self: end;
      margin-top: -10vw;
      transform: rotate(-1.5deg);
    }

    .hero-classic-stamp {
      top: 41%;
      right: 2px;
      width: 72px;
      height: 72px;
      font-size: 7px;
    }

    .hero-classic-bottom {
      grid-template-columns: 1fr;
      gap: 26px;
    }

    .hero-classic-bottom p {
      max-width: 92%;
      font-size: 18px;
      line-height: 1.34;
    }

    .hero-classic-actions {
      width: 100%;
      justify-content: space-between;
      align-items: center;
    }

    .hero-round-link { width: 82px; height: 82px; }
  }

  @media (max-width: 420px) {
    .hero-classic { padding-inline: 15px; }
    .hero-classic-meta span:first-child { max-width: 190px; }
    .hero-classic-title { font-size: clamp(76px, 28vw, 118px); }
    .hero-word--men { margin-left: 9vw; }
    .hero-classic-poster { width: 88vw; margin-top: -7vw; }
    .hero-classic-stamp { top: 39%; right: 0; }
    .hero-classic-bottom p { max-width: 100%; font-size: 17px; }
  }
</style>
