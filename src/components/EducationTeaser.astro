---
import { articles } from '../data/articles';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<section class="home-articles">
  <div class="articles-head">
    <div>
      <div class="page-kicker">03 / BACA & BELAJAR</div>
      <h2>ARTIKEL<br />EDUKASI.</h2>
    </div>
    <a class="action-link magnetic" href={`${base}articles/`}>SEMUA ARTIKEL ↗</a>
  </div>
  <div class="article-preview-grid">
    {articles.slice(0, 3).map((article) => (
      <a class="article-preview" href={`${base}articles/${article.slug}/`}>
        <div class="article-preview-media"><img src={`${base}${article.cover}`} alt="" loading="lazy" decoding="async" /></div>
        <span class="eyebrow">{article.eyebrow} · {article.readingTime}</span>
        <h3>{article.title}</h3>
        <p>{article.excerpt}</p>
        <span class="read-more">BACA ARTIKEL ↗</span>
      </a>
    ))}
  </div>
</section>
