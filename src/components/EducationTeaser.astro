---
import { articles } from '../data/articles';
import { articleCovers } from '../data/articleCovers';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const transparentPixel = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==';
---
<section class="home-articles">
  <div class="articles-head">
    <div>
      <div class="page-kicker">03 / ARTIKEL</div>
      <h2>CATATAN<br />SENIMEN.</h2>
    </div>
    <a class="action-link magnetic" href={`${base}articles/`}>SEMUA ARTIKEL ↗</a>
  </div>
  <div class="article-preview-grid">
    {articles.slice(0, 3).map((article) => {
      const cover = articleCovers[article.slug] ?? `${base}${article.cover}`;
      return (
        <a class="article-preview" href={`${base}articles/${article.slug}/`}>
          <div class="article-preview-media article-preview-media--full">
            <img
              src={transparentPixel}
              data-defer-src={cover}
              alt=""
              width="1448"
              height="1086"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
            />
            <noscript><img src={cover} alt="" loading="lazy" decoding="async" /></noscript>
          </div>
          <span class="eyebrow">{article.eyebrow} · {article.readingTime}</span>
          <h3>{article.title}</h3>
          <p>{article.excerpt}</p>
          <span class="read-more">BACA ARTIKEL ↗</span>
        </a>
      );
    })}
  </div>
</section>

<style>
  .article-preview-media--full {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    background: #111;
  }
  .article-preview-media--full img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }
  .article-preview:hover .article-preview-media--full img { transform: none; }
</style>
