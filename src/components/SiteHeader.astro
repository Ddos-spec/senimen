---
import { brand } from '../data/brand';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const pathname = Astro.url.pathname;
const nav = [
  ['TENTANG', 'about/'],
  ['ARSIP', 'archive/'],
  ['ARTIKEL', 'articles/'],
  ['GABUNG', 'join/'],
] as const;
---
<header class="global-header" data-header>
  <a class="senimen-wordmark magnetic" href={base} aria-label="SENIMEN, kembali ke beranda">
    <img src={brand.logoSmall} alt="" width="360" height="144" decoding="async" fetchpriority="low" />
  </a>
  <nav class="desktop-nav" aria-label="Navigasi utama">
    {nav.map(([label, href]) => (
      <a href={`${base}${href}`} aria-current={pathname.includes(`/${href}`) ? 'page' : undefined}>{label}</a>
    ))}
  </nav>
  <button class="menu-toggle magnetic" aria-expanded="false" aria-controls="site-menu"><span>MENU</span><i></i></button>
</header>

<nav class="menu" id="site-menu" aria-hidden="true" inert>
  <div class="menu-noise"></div>
  <div class="menu-index">INDEX / 001—004</div>
  {nav.map(([label, href], index) => (
    <a href={`${base}${href}`} data-menu-link><span>{String(index + 1).padStart(2, '0')}</span>{label}</a>
  ))}
  <a class="menu-instagram" href="https://www.instagram.com/komunitas_senimen/" target="_blank" rel="noreferrer">INSTAGRAM ↗</a>
</nav>

<style>
  .senimen-wordmark {
    width: clamp(116px, 10vw, 156px);
    height: 40px;
    overflow: hidden;
    display: block;
    background: #050505;
    border: 1px solid #050505;
  }
  .senimen-wordmark img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: 50% 50%;
    transform: scale(1.55);
  }
  @media (max-width: 760px) {
    .senimen-wordmark { width: 118px; height: 34px; }
  }
</style>
